# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/dustbunny"

# Gmail API (optional - required only for Gmail integration features)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# OpenAI (optional - used for AI classification and summaries)
OPENAI_API_KEY="your-openai-api-key"

# HaveIBeenPwned (optional - required for privacy breach scanning)
HIBP_API_KEY="your-hibp-api-key"

# NextAuth (optional - was used with older auth, now using custom auth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# App Config
NODE_ENV="development"
