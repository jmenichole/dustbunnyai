# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/dustbunny"

# Email Provider OAuth Credentials (choose one or more)
# Gmail API (optional - for Gmail integration)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# Microsoft/Outlook (optional - for Outlook/Microsoft 365 integration)
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/microsoft/callback"

# Yahoo Mail (optional - for Yahoo integration, requires IMAP implementation)
YAHOO_CLIENT_ID="your-yahoo-client-id"
YAHOO_CLIENT_SECRET="your-yahoo-client-secret"
YAHOO_REDIRECT_URI="http://localhost:3000/api/auth/yahoo/callback"

# iCloud Mail (optional - for iCloud integration, requires IMAP implementation)
ICLOUD_CLIENT_ID="your-icloud-client-id"
ICLOUD_CLIENT_SECRET="your-icloud-client-secret"
ICLOUD_REDIRECT_URI="http://localhost:3000/api/auth/icloud/callback"

# AI Features (optional - used for AI classification and summaries)
OPENAI_API_KEY="your-openai-api-key"

# Privacy Features (optional - required for privacy breach scanning)
HIBP_API_KEY="your-hibp-api-key"

# NextAuth (optional - was used with older auth, now using custom auth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# App Config
NODE_ENV="development"
